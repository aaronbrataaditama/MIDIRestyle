<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MidiRestyle.App.ViewModels"
        x:Class="MidiRestyle.App.Views.ScaleEditorWindow"
        x:DataType="vm:ScaleEditorViewModel"
        Title="Custom scale"
        Icon="avares://MIDIRestyle/Assets/app-icon.ico"
        Width="520" Height="680"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="14">

    <!-- Validation and the save row. Docked bottom so the reason is always visible while typing. -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">

      <!--
        The message comes from Scale's own constructor, which already explains the downstream
        consequence of each rule. Anything this layer invented would be vaguer.
      -->
      <Border Padding="8,6" CornerRadius="3" Background="#22000000"
              IsVisible="{Binding ValidationMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" FontSize="11" />
      </Border>

      <TextBlock Classes="hint" IsVisible="{Binding IsCopyOnEdit}"
                 Text="{x:Static vm:ScaleEditorViewModel.CopyOnEditExplanation}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Delete" Click="OnDeleteClicked" IsEnabled="{Binding CanDelete}" />
        <Button Content="Cancel" Click="OnCancelClicked" />
        <Button Content="Save" Click="OnSaveClicked" IsEnabled="{Binding IsValid}"
                IsDefault="True" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel>

        <TextBlock Classes="field" Text="NAME" />
        <TextBox Text="{Binding Name}" />

        <TextBlock Classes="field" Text="ID" />
        <Grid ColumnDefinitions="Auto,*">
          <!-- The prefix is not editable. An id outside this namespace is not expressible, so
               shadowing a shipped scale is impossible rather than merely checked for. -->
          <TextBlock Grid.Column="0" Text="user." VerticalAlignment="Center" Opacity="0.6"
                     FontFamily="Consolas,Menlo,monospace" />
          <TextBox Grid.Column="1" Text="{Binding IdSlug}" FontFamily="Consolas,Menlo,monospace" />
        </Grid>

        <Grid ColumnDefinitions="*,8,*">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field" Text="TRADITION" />
            <TextBox Text="{Binding Tradition}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="field" Text="REGION" />
            <TextBox Text="{Binding Region}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="field" Text="SOURCE" />
        <TextBox Text="{Binding Source}" />
        <TextBlock Classes="hint"
                   Text="Where the tuning came from. Defaults to &quot;user-defined&quot;, which is honest for a tuning you invented - but if you took it from somewhere, say so here." />

        <TextBlock Classes="field" Text="DEGREES" />
        <TextBlock Classes="hint" Margin="0,0,0,6"
                   Text="Cents above the tonic, ascending, starting at 0. Type a ratio with a slash (5/4) or a plain number for cents (386.31). The octave is implicit - do not enter 1200." />

        <ItemsControl ItemsSource="{Binding Degrees}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:DegreeEntryViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                <TextBox Grid.Column="0" Text="{Binding Text}"
                         FontFamily="Consolas,Menlo,monospace" />
                <!-- A half-typed entry reads as neutral, never as an error. -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontSize="11"
                           Opacity="0.7" Text="{Binding Cents, StringFormat='{}{0:0.##} c'}" />
                <Button Grid.Column="2" Content="&#215;" Click="OnRemoveDegreeClicked"
                        Padding="8,2" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Add degree" Command="{Binding AddDegreeCommand}" Margin="0,4,0,0"
                HorizontalAlignment="Left" />

        <TextBlock Classes="field" Text="NOTATION" />
        <CheckBox Content="Can be written on a Western staff" IsChecked="{Binding Notatable}" />
        <TextBlock Classes="hint" Text="{x:Static vm:ScaleEditorViewModel.NotatableExplanation}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button Content="Use the derived guess" Command="{Binding UseDerivedNotatableCommand}"
                  IsEnabled="{Binding IsNotatableManualOverride}" />
          <TextBlock Classes="hint" VerticalAlignment="Center"
                     Text="{Binding DerivedNotatableGuess, StringFormat='derived: {0}'}" />
        </StackPanel>

        <TextBlock Classes="field" Text="DESCRIPTION" />
        <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="60"
                 TextWrapping="Wrap" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
