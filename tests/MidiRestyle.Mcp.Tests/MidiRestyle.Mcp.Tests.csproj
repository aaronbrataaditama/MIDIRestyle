<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3 test projects must be executables: MTP runs each assembly as its own process. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>MidiRestyle.Mcp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MidiRestyle.Mcp/MidiRestyle.Mcp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The pinned wire contract. Copied to the output folder because ContractTests reads it from
         AppContext.BaseDirectory; the copy in the source tree is the one that is reviewed and
         committed, and MIDIRESTYLE_UPDATE_GOLDEN=1 rewrites both. -->
    <None Include="Contract/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
