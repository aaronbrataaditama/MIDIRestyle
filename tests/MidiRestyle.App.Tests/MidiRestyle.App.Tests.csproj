<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit.v3 test projects must be executables: MTP runs each assembly as its own process. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>MidiRestyle.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MidiRestyle.App/MidiRestyle.App.csproj" />
  </ItemGroup>

</Project>
